<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tn.sncft.trino</groupId>
        <artifactId>trino-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>simulateur</artifactId>
    <packaging>jar</packaging>

    <name>Trino Simulateur</name>
    <description>GPS feed producer - separate process, HTTP client only, no database</description>

    <!--
      Deliberately minimal. This module stands in for AVL hardware, so it gets
      an HTTP client and nothing else: no persistence, no connection pool, no
      web server (the api module is the only one in this project). Adding
      persistence here would let the simulator write state the real hardware
      could never write, and the swap stops being a configuration change.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient, without dragging in a servlet container. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Jackson plus the JSR-310 module, for OffsetDateTime payloads. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!--
          Test scope only, added in phase 9 so this module can carry the geometry
          parity assertion. It is NOT a dependency on the api module and must not
          become one: GeometrieCourse duplicates GeometrieLigne on purpose
          (invariant 3), and the two are pinned to a shared JSON fixture at
          backend/parite-geometrie.json rather than to each other.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
